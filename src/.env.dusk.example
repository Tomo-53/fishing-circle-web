# Dusk(e2e) 用の環境設定テンプレート。
# ローカルで Dusk を回す場合は、このファイルを `.env.dusk.local` にコピーして使う。
#   cp .env.dusk.example .env.dusk.local
# `php artisan dusk` 実行時、APP_ENV=local なら自動的に `.env.dusk.local` が読み込まれる。
#
# 重要: Dusk は「php artisan serve のサーバープロセス」と「テストプロセス」が別々に動くため、
# in-memory SQLite(:memory:) は共有できない。必ずファイル SQLite を使うこと。

APP_NAME=新潟大学釣り同好会
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

BCRYPT_ROUNDS=4

# e2e はサーバーとテストで同じ DB ファイルを共有する
DB_CONNECTION=sqlite
DB_DATABASE=database/dusk.sqlite

SESSION_DRIVER=database
QUEUE_CONNECTION=sync
CACHE_STORE=database
MAIL_MAILER=array

VITE_APP_NAME="${APP_NAME}"
