# Dusk(e2e) 用の環境設定テンプレート。
# ローカルで Dusk を回す場合は、このファイルを `.env.dusk.local` にコピーして使う。
#   cp src/.env.dusk.example src/.env.dusk.local
# `php artisan dusk` 実行時、APP_ENV=local なら自動的に `.env.dusk.local` が読み込まれる。
#
# 重要: Dusk は「php artisan serve のサーバープロセス」と「テストプロセス」が別々に動くため、
# in-memory SQLite(:memory:) は共有できない。必ずファイル SQLite を使うこと。

APP_NAME=新潟大学釣り同好会
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# ループバック(127.0.0.1)を使うことで Chrome の HTTPS 自動アップグレードを回避できる。
# Docker が 8000 を使用中の場合は 8001 等の別ポートにして serve --port= と合わせる。
APP_URL=http://127.0.0.1:8001

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

BCRYPT_ROUNDS=4

# e2e はサーバーとテストで同じ DB ファイルを共有する
DB_CONNECTION=sqlite
DB_DATABASE=database/dusk.sqlite

# サーバープロセスとテストプロセスで DB 接続が別になるため、
# database ドライバーは使えない。file を使う。
SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file
MAIL_MAILER=array

VITE_APP_NAME="${APP_NAME}"
